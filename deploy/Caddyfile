# Replace {$DOMAIN} with your actual domain, e.g. api.yourdomain.com
# Caddy auto-provisions TLS via Let's Encrypt.

{$DOMAIN:localhost} {
    # Reverse proxy to the FastAPI service
    reverse_proxy market-data-api:8010

    # Security headers (Caddy adds some by default, these are extras)
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Request size limit (prevent abuse)
    request_body {
        max_size 1MB
    }

    # Logging
    log {
        output file /data/access.log {
            roll_size 100MB
            roll_keep 5
        }
    }
}

# Health check endpoint (no TLS, internal only)
:8080 {
    respond /health 200
}
