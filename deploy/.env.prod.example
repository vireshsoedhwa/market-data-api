# =============================================================================
# Production Environment Variables
# Copy this to .env.prod and fill in real values. NEVER commit .env.prod.
# =============================================================================

# --- Domain ---
DOMAIN=api.yourdomain.com

# --- Database ---
POSTGRES_DB=stock_dashboard
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

DATABASE_URL=postgresql+asyncpg://stock_user:CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD@db:5432/stock_dashboard

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
REDIS_URL=redis://:CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD@redis:6379/0

# --- API Authentication ---
MARKET_DATA_INTERNAL_API_KEY=CHANGE_ME_TO_A_64_CHAR_RANDOM_TOKEN

# --- Provider API Keys ---
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
STOCKDATA_API_KEY=
TIINGO_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
MASSIVE_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BATCH_MAX_SYMBOLS=50
